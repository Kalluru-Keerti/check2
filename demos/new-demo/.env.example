# Resume Role-Fit Analyser (DEMO-RESUME-001) - copy to .env and fill in values
# All data is synthetic. Never commit a real .env.
DEMO_MODE=mock
VITE_API_BASE_URL=http://localhost:8000/api
VITE_DEMO_TITLE="IBM Role-Fit Resume Analyser - Built with IBM watsonx"
VITE_DEMO_CLIENT_CODE=DEMO-RESUME-001

# watsonx.ai (only needed when DEMO_MODE=live)
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
# Use WATSONX_SPACE_ID INSTEAD of the project id if you work in a deployment space (exactly one)
WATSONX_SPACE_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL_ID=meta-llama/llama-4-maverick-17b-128e-instruct-fp8

# Upload limits
MAX_UPLOAD_MB=10
